# Superuser connection used only by `pnpm db:setup` (creates the app role, runs migrations).
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_hub
# Password given to the restricted `pos_app` role that the API connects as.
APP_DB_PASSWORD=pos_app_dev

# API
DATABASE_URL=postgres://pos_app:pos_app_dev@localhost:5432/pos_hub
PORT=4000
CORS_ORIGIN=http://localhost:3000
# dev = HS256 tokens issued by POST /dev/token; jwks = tokens from your identity provider (Clerk, Auth0, ...)
AUTH_MODE=dev
AUTH_DEV_SECRET=change-me-dev-secret-at-least-32-chars
# AUTH_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
# AUTH_ISSUER=https://<your-clerk-domain>
# AUTH_AUDIENCE=

# Web
API_URL=http://localhost:4000
# URL phones and registers use to reach the API (your machine's LAN address in development)
# PUBLIC_API_URL=http://192.168.1.20:4000

# Payments: "simulated" (default; the register shows approve/decline buttons) or "stripe"
PAYMENTS_PROVIDER=simulated
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint: POST <API>/webhooks/stripe)
# STRIPE_ACCOUNT=acct_...           (optional: charge on behalf of a Connect account)

# Subscriptions for Ample POS itself: "simulated" (default; subscribing needs no card) or "stripe".
# Uses Ample POS's own Stripe account; products and prices are created on first use.
BILLING_PROVIDER=simulated
# BILLING_STRIPE_SECRET_KEY=sk_test_...
# BILLING_STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint: POST <API>/webhooks/stripe-billing)

# Encrypts stored integration credentials (Shopify tokens). Generate with: openssl rand -base64 32
# SECRETS_KEY=
# Public URL of the API, used for the webhook address given to Shopify (e.g. https://api.yourpos.com)
# PUBLIC_API_URL=
# Background worker (stock pushes, Shopify webhooks, reconciliation) runs inside the API by default.
# WORKER_ENABLED=true
# Ample POS's Shopify app, from the Shopify Dev Dashboard. Enables "Connect with Shopify".
# Add <WEB_URL>/shopify/callback as an allowed redirect URL in the app's settings.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# WEB_URL=http://localhost:3000
