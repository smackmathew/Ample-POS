{
  "expo": {
    "name": "Ample POS",
    "slug": "ample-pos",
    "scheme": "amplepos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.amplepos.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.amplepos.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ample POS uses the camera to scan product barcodes and pairing codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Ample POS uses your location to keep card payments secure.",
          "bluetoothPeripheralPermission": "Ample POS uses Bluetooth to connect to card readers.",
          "bluetoothAlwaysUsagePermission": "Ample POS uses Bluetooth to connect to card readers."
        }
      ]
    ],
    "extra": {
      "defaultApiUrl": "http://localhost:4000"
    }
  }
}
